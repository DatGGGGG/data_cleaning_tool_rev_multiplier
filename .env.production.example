# Copy this file to .env.production on the VM. Never commit the populated file.
ST_API_KEY=""
SENSORTOWER_BASE_URL="https://api.sensortower.com"
ENABLE_SENSORTOWER_AUTO_REFRESH="true"
# Generate a private value before enabling protected manual refresh calls.
SENSORTOWER_REFRESH_TOKEN=""

# Bottom Up Step 0 should use the production VN Strategy API on the VM, not Windows file paths.
BOTTOM_UP_PRODUCTION_SOURCE="api"
# The VN Strategy Data System API is exposed on VM port 8001 in the current Docker setup.
STRATEGY_DATA_API_BASE_URL="http://host.docker.internal:8001"
STRATEGY_DATA_API_KEY=""
STRATEGY_DATA_API_PAGE_SIZE="500"
